<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
	<op:config name="%NUK_NumChannelsDefault%" value="0" />
	<ManufacturerData>
		<Manufacturer>
			<ApplicationPrograms>
				<ApplicationProgram>
					<Static>
						<ParameterTypes>

							<ParameterType Id="%AID%_PT-NUKNumChannels" Name="NUKNumChannels">
								<TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="%N%" />
							</ParameterType>
							<ParameterType Id="%AID%_PT-NUKChannelType" Name="NUKChannelType">
								<TypeRestriction Base="Value" SizeInBit="4">
									<Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
									<Enumeration Text="Smart Lock" Value="1" Id="%ENID%" />
									<Enumeration Text="Opener" Value="2" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-NUKDoorMode" Name="NUKDoorMode">
								<TypeRestriction Base="Value" SizeInBit="4">
									<Enumeration Text="Versperrwartezeit fortsetzen" Value="0" Id="%ENID%" />
									<Enumeration Text="Versperrwartezeit neu starten" Value="1" Id="%ENID%" />
									<Enumeration Text="Versperren nach" Value="2" Id="%ENID%" />
									<Enumeration Text="bei OpenKNX Lock'n'Go versperren nach" Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-NUKLockNGoCountDownKo" Name="NUKLockNGoCountDownKo">
								<TypeRestriction Base="Value" SizeInBit="4">
									<Enumeration Text="Keines" Value="0" Id="%ENID%" />
									<Enumeration Text="Sekunden" Value="1" Id="%ENID%" />
									<Enumeration Text="Minuten" Value="2" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-NUKLockNGoMode" Name="NUKLockNGoMode">
								<TypeRestriction Base="Value" SizeInBit="1">
									<Enumeration Text="Entsperren" Value="0" Id="%ENID%" />
									<Enumeration Text="Lasche ziehen" Value="1" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>

							<ParameterType Id="%AID%_PT-NUKUseCountDownForAutoLock" Name="NUKUseCountDownForAutoLock">
								<TypeRestriction Base="Value" SizeInBit="2">
									<Enumeration Text="Nein" Value="0" Id="%ENID%" />
									<Enumeration Text="Ja" Value="1" Id="%ENID%" />
									<Enumeration Text="Nur die letzte Minute" Value="2" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>


							<ParameterType Id="%AID%_PT-NUKAutoLock" Name="NUKAutoLock">
								<TypeRestriction Base="Value" SizeInBit="2">
									<Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
									<Enumeration Text="Bei Tag und Nacht" Value="1" Id="%ENID%" />
									<Enumeration Text="Bei Tag" Value="2" Id="%ENID%" />
									<Enumeration Text="Bei Nacht" Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>

							<ParameterType Id="%AID%_PT-NUKLock" Name="NUKAlarm">
								<TypeRestriction Base="Value" SizeInBit="1">
									<Enumeration Text="einfach" Value="0" Id="%ENID%" />
									<Enumeration Text="2-fach" Value="1" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>

							<ParameterType Id="%AID%_PT-NUKLockNGoRepeat" Name="NUKLockNGoRepeat">
								<TypeRestriction Base="Value" SizeInBit="2">
									<Enumeration Text="Nichts" Value="0" Id="%ENID%" />
									<Enumeration Text="Zeit neu starten" Value="1" Id="%ENID%" />
									<Enumeration Text="Versperren" Value="2" Id="%ENID%" />
									<Enumeration Text="Dauerhaft entsperren" Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>

							<ParameterType Id="%AID%_PT-NUKLockNGoOff" Name="NUKLockNGoOff">
								<TypeRestriction Base="Value" SizeInBit="2">
									<Enumeration Text="Nichts" Value="0" Id="%ENID%" />
									<Enumeration Text="Versperren" Value="1" Id="%ENID%" />
									<Enumeration Text="Dauerhaft entsperren wenn aktiv, sonst versperren" Value="2" Id="%ENID%" />
									<Enumeration Text="Dauerhaft entsperren wenn aktiv" Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>


							<ParameterType Id="%AID%_PT-NUKNight" Name="NUKNight">
								<TypeRestriction Base="Value" SizeInBit="8">
									<Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
									<!-- <Enumeration Text="Nuki Einstellung" Value="1" Id="%ENID%" /> -->
									<Enumeration Text="Zeitfenster" Value="2" Id="%ENID%" />
									<Enumeration Text="Objekt" Value="3" Id="%ENID%" />
									<Enumeration Text="Objekt UND Zeitfenster" Value="4" Id="%ENID%" />
									<Enumeration Text="Objekt ODER Zeitfenster" Value="5" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>

							<ParameterType Id="%AID%_PT-NUKNightAction" Name="NUKNightAction">
								<TypeRestriction Base="Value" SizeInBit="4">
									<Enumeration Text="keine Aktion" Value="0" Id="%ENID%" />
									<Enumeration Text="einfach versperren" Value="1" Id="%ENID%" />
									<Enumeration Text="2-fach versperren" Value="2" Id="%ENID%" />
									<Enumeration Text="entsperren" Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>

							<ParameterType Id="%AID%_PT-NUKTime" Name="NUKTime">
								<TypeTime SizeInBit="16" Unit="Minutes" minInclusive="0" maxInclusive="1440" UIHint="Time_hhmm" />
							</ParameterType>
							
							<ParameterType Id="%AID%_PT-NUKAlarm" Name="NUKAlarm">
								<TypeRestriction Base="Value" SizeInBit="2">
									<Enumeration Text="nicht aktiv" Value="0" Id="%ENID%" />
									<Enumeration Text="wenn Tür offen und Nuki versperrt" Value="1" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							
						</ParameterTypes>
						<Parameters>
							<!-- Base Settings -->
							<Union SizeInBit="8">
								<Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
								<!-- Number of channels -->
								<Parameter Id="%AID%_UP-%TT%00000" Name="VisibleChannels" ParameterType="%AID%_PT-NUKNumChannels" Offset="0" BitOffset="0" Text="Verfügbare Kanäle" Value="%NUK_NumChannelsDefault%" SuffixText=" von %N%" />
							</Union>
							<!-- Add not allowed -->
							<Parameter Id="%AID%_P-%TT%00001" Name="AddNotAllowed" ParameterType="%AID%_PT-OnOffYesNo" Text="AddNotAllowed" Value="0" Access="None"/>
						</Parameters>
						<ParameterRefs>
							<!-- Number of channels -->
							<ParameterRef Id="%AID%_UP-%TT%00000_R-%TT%0000001" RefId="%AID%_UP-%TT%00000" />
							<!-- Add not allowed -->
							<ParameterRef Id="%AID%_P-%TT%00001_R-%TT%0000101" RefId="%AID%_P-%TT%00001" />
						</ParameterRefs>
						<ComObjectTable>
						</ComObjectTable>
						<ComObjectRefs>
						</ComObjectRefs>
						<Script>
							<op:include href="Nuki.script.js" prefix="NUK" type="script" />
						</Script>
					</Static>
					<Dynamic>
						<Channel Name="MainChannel%TT%" Text="Nuki" Number="%PREFIX%" Id="%AID%_CH-%TT%" Icon="lock-outline">
							<ParameterBlock Id="%AID%_PB-nnn" Name="NukiSettings" Text="Basiseinstellungen" Icon="cog-outline" HelpContext="Empty">

								<ParameterSeparator Id="%AID%_PS-nnn" Text="Nuki" UIHint="Headline" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />

								<ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

								<!-- NUK Client Kanalauswahl -->
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
								<!-- Kanalanzahl -->
								<ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%00000_R-%TT%0000001" HelpContext="%DOC%" />

								<op:include href="Nuki.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="NUK" IsInner="true" />


							</ParameterBlock>
							
							<op:include href="Nuki.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*" type="template" prefix="NUK" IsInner="true" />

							<!-- More Page -->
							<choose ParamRefId="%AID%_UP-%TT%00000_R-%TT%0000001">
								<when test="&lt;%N%">
									<ParameterBlock Id="%AID%_PB-nnn" Name="NUKAdditionalChannels" Text="(mehr)" Icon="dots-horizontal">										<!-- HelpContext="Empty" -->
										<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
										<!-- <ParameterRefRef RefId="%AID%_UP-%TT%00000_R-%TT%0000001" HelpContext="%DOC%" /> -->

										<op:include href="Nuki.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='More']/*" type="template" prefix="NUK" IsInner="true" />
										
										 <!-- Hidden -->
										 <!-- Add not allowed -->
										<ParameterRefRef RefId="%AID%_P-%TT%00001_R-%TT%0000101" />
										<choose ParamRefId="%AID%_P-%TT%00001_R-%TT%0000101" >
											<when test="1">
												<ParameterSeparator Id="%AID%_PS-nnn" Text="Hinzufügen von 'Deaktiviert' nicht möglich. Es muss zuerst eine Auswahl getroffen werden." UIHint="Error" />
											</when>
										</choose>
										
										<Button Id="%AID%_B-%TT%00200" Text="Hinzufügen" EventHandler="nukAddChannel" />

										<!-- HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" /-->
									</ParameterBlock>
								</when>
							</choose>
						</Channel>
					</Dynamic>
				</ApplicationProgram>
			</ApplicationPrograms>
			<Baggages>
				<Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
					<FileInfo TimeInfo="%DATETIME%" />
				</Baggage>
				<Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
					<FileInfo TimeInfo="%DATETIME%" />
				</Baggage>
			</Baggages>
		</Manufacturer>
	</ManufacturerData>
</KNX>
